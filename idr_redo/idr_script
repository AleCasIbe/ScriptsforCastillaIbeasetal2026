bedtools intersect -v -a     ./CONS_PEAKS/${name_folder}_pool_toppeaks.bed -b /home/castillaa/chip/IDR/idr_redo/mm10-blacklist.v2.bed >     ./CONS_PEAKS/${name_folder}_pool_toppeaks_bl.bed &
